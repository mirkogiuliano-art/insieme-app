# Copia questo file in .env e riempi con i valori del tuo progetto Supabase
# (Project Settings → API nel dashboard supabase.com). .env è già ignorato
# da git (vedi .gitignore) — non committare mai le tue chiavi reali.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Accesso con Google (istruzioni complete in docs/accesso-google.md).
# Sono gli id OAuth creati su Google Cloud: non sono segreti, finiscono
# comunque dentro l'app. Finché WEB è vuoto il tasto «Accedi con Google»
# non compare. Per le build di EAS vanno messi anche lì (eas env:create):
# EAS non legge questo file.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Segnalazione degli errori (istruzioni in docs/segnalazione-errori.md).
# Il DSN del progetto Sentry: non è un segreto. Finché è vuoto Sentry è
# spento. Per le build va messo anche su EAS (eas env:create).
EXPO_PUBLIC_SENTRY_DSN=
