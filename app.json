{
  "expo": {
    "name": "Insieme",
    "slug": "insieme-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "insieme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E141B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.insieme.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Insieme usa la tua posizione per centrare la mappa e aiutarti a salvare i posti vicino a te.",
        "NSCameraUsageDescription": "Insieme usa la fotocamera per scattare foto e video da condividere in chat.",
        "NSPhotoLibraryUsageDescription": "Insieme accede alle tue foto per condividerle in chat.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.insieme.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E141B"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB8cVQHXtTTigNbh6nomXJAceuFsQYusaA"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Insieme usa la tua posizione per centrare la mappa e aiutarti a salvare i posti vicino a te."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Insieme accede alle tue foto per condividerle in chat.",
          "cameraPermission": "Insieme usa la fotocamera per scattare foto e video da condividere in chat."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Insieme usa il microfono per registrare i messaggi vocali in chat."
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "video/*"
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a13a8a26-8924-4953-a300-6340e3d901e5"
      }
    }
  }
}
